server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same contract as the Vite dev proxy: /api/* -> backend with the prefix stripped.
    # BACKEND_URL / BACKEND_HOST are filled in by the nginx image's envsubst at startup.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        # Render (and any TLS upstream) routes by hostname, so send SNI and the backend's Host.
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /chat/stream is NDJSON streaming and agent turns can run for minutes.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;

        # RAG uploads (RAG_MAX_UPLOAD_MB defaults to 20).
        client_max_body_size 25m;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
